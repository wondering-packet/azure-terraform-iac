terraform.tfstate
terraform.tfstate.backup
*.tfvars
*.tfvars.json
crash.log
override.tf
override.tf.json
test*
# Terraform state — never commit (contains secrets, resource IDs)
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Provider binaries — regenerated by terraform init
.terraform/
.terraform.tfstate.lock.info

# Variable files may contain secrets
*.tfvars
!example.tfvars

# Scratch drills — throwaway concept practice, not part of the real environment
_scratch/

# Crash logs
crash.log
crash.*.log

# Plan output files
*.tfplan
tfplan

# IDE
.vscode/
.idea/

# NOTE: .terraform.lock.hcl is intentionally NOT ignored — it must be committed
# to pin provider versions across the team.
azure-terraform-labs-old/
tf-exports*
aztf*